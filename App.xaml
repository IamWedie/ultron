<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ultron.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="UltronCharcoal">#FF121316</Color>
            <Color x:Key="UltronGunmetal">#FF1D1F24</Color>
            <Color x:Key="UltronCrimson">#FFFF2E2E</Color>
            <Color x:Key="UltronGold">#FFFFB703</Color>
            <Color x:Key="UltronAmber">#FFFF7B00</Color>
            <SolidColorBrush x:Key="UltronCharcoalBrush" Color="{StaticResource UltronCharcoal}" />
            <SolidColorBrush x:Key="UltronGunmetalBrush" Color="{StaticResource UltronGunmetal}" />
            <SolidColorBrush x:Key="UltronCrimsonBrush" Color="{StaticResource UltronCrimson}" />
            <SolidColorBrush x:Key="UltronGoldBrush" Color="{StaticResource UltronGold}" />
            <SolidColorBrush x:Key="UltronAmberBrush" Color="{StaticResource UltronAmber}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>