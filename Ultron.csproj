<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ultron</RootNamespace>
    <AssemblyName>ULTRON</AssemblyName>
    <ApplicationTitle>ULTRON</ApplicationTitle>
    <ApplicationIcon>Ultron.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- We provide our own Main (Program.cs) so the watchdog argument is handled before XAML boots. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- NoWarn lives in Directory.Build.props so the app + tools/Tests share it -->
    <!-- This is a pure-C# WinUI app; the XAML compiler's interop targets try to locate the MSVC
         toolset (GetLatestMSVCVersion) only when VCInstallPath32/64 are empty. Presetting them
         lets VS build without the C++ workload installed. -->
    <VCInstallPath32>$(VCToolsInstallDir)bin\HostX64\x86</VCInstallPath32>
    <VCInstallPath64>$(VCToolsInstallDir)bin\HostX64\x64</VCInstallPath64>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!-- The C# app no longer runs any ONNX model: local Whisper STT and the C#
       SileroVad are deleted, and speech recognition/synthesis are cloud-only.
       The remaining silero-vad.onnx is loaded by the Python backend through its
       own onnxruntime dependency, so no managed inference runtime is needed here. -->

  <ItemGroup>
    <Content Include="Assets\**" />
    <Content Include="Ultron.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="backend\**" CopyToOutputDirectory="PreserveNewest" Exclude="backend\__pycache__\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <Page Remove="tools\**" />
    <None Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

</Project>