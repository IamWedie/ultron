<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the SUT source directly (same pattern as tools/Smoke) so the
         tested services are the real ones, no WinUI dependency required. -->
    <Compile Include="..\..\Models\Conversation.cs" />
    <Compile Include="..\..\Services\AppSettings.cs" />
    <Compile Include="..\..\Services\AppLog.cs" />
    <Compile Include="..\..\Services\Secrets.cs" />
    <Compile Include="..\..\Services\MemoryStore.cs" />
    <Compile Include="..\..\Services\LongTermMemory.cs" />
    <Compile Include="..\..\Services\GeminiBackend.cs" />
    <Compile Include="..\..\Services\Outreach.cs" />
    <Compile Include="..\..\Services\UltronOptions.cs" />
    <Compile Include="..\..\Services\TrayIcon.cs" />
    <Compile Include="..\..\Services\HotkeyService.cs" />
    <!-- Tool layer: deliberately WinUI-free so routing/policy is unit-testable. -->
    <Compile Include="..\..\Services\Tools\ToolCall.cs" />
    <Compile Include="..\..\Services\Tools\ToolResult.cs" />
    <Compile Include="..\..\Services\Tools\IToolHandler.cs" />
    <Compile Include="..\..\Services\Tools\ToolPolicy.cs" />
    <Compile Include="..\..\Services\Tools\PolicyEngine.cs" />
    <Compile Include="..\..\Services\Tools\ToolRouter.cs" />
    <Compile Include="..\..\Services\UndoLedger.cs" />
  <Compile Include="..\..\Services\AdbShell.cs" />
    <Compile Include="..\..\Services\Tools\Files\PathPolicy.cs" />
    <Compile Include="..\..\Services\Tools\Files\FileToolService.cs" />
    <Compile Include="..\..\Services\Processes\IProcessLauncher.cs" />
    <Compile Include="..\..\Services\Processes\CommandRunner.cs" />
    <Compile Include="..\..\Services\Apps\AppResolver.cs" />
    <Compile Include="..\..\Services\Tools\Apps\AppToolService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>